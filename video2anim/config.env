# ===== video2anim config — edit these, everything else reads from here =====

# --- Job ---
JOB_NAME="${JOB_NAME:-clip01}"                 # folder name used in B2 for this run
INPUT_VIDEO="${INPUT_VIDEO:-input/clip01.mp4}"    # path INSIDE the B2 bucket (upload your video here)
CHARACTER_FILE="${CHARACTER_FILE:-characters/hero.fbx}"  # rigged character in B2 (.fbx / .glb / .blend)
BONE_MAP="${BONE_MAP:-bone_maps/hero.json}"    # joint->bone map in B2 (made once per skeleton, see README)
PERSON_INDEX="${PERSON_INDEX:-0}"                    # which tracked person drives the character (0 = first)

# --- Storage (Backblaze B2) ---
B2_BUCKET="Runpodmodels2099"
# B2_APPLICATION_KEY_ID / B2_APPLICATION_KEY must be set as pod env vars (RunPod "secrets")

# --- Hugging Face (needed for SAM 3 / SAM 3D Body access + your LoRA) ---
# HF_TOKEN must be set as a pod env var
LORA_HF_REPO="${LORA_HF_REPO:-your-hf-name/your-krea2-lora}"   # <- your Krea 2 LoRA repo
LORA_FILE="${LORA_FILE:-your_lora.safetensors}"
LORA_STRENGTH="${LORA_STRENGTH:-0.9}"
STYLE_PROMPT="${STYLE_PROMPT:-TRIGGERWORD, cinematic animated film still, soft even studio light, pure white background}"

# --- Render (Stage 2) ---
RENDER_W=540                      # low-res Eevee render (upscaled 2x later)
RENDER_H=960
FPS=30
EEVEE_SAMPLES=8
LENS_MM=16                        # wide lens close to character (Void look)
ORBIT_DEGREES=90                  # camera orbit over the whole clip; 0 = static
VOID_WHITE=1                      # 1 = pure white infinite void, no floor

# --- Style transfer (Stage 2) ---
STYLE_W=1088                      # Krea needs multiples of 16; final video is scaled to 1080x1920
STYLE_H=1920
DENOISE="${DENOISE:-0.40}"                      # lower = closer to render, less flicker. 0.30-0.50 sensible
STEPS=8                           # Krea 2 Turbo default
CFG=1.0
SEED="${SEED:-12345}"                        # fixed seed every frame = less flicker

# --- Budget (USD) ---
TOTAL_BUDGET_USD=45
STAGE1_RATE_USD_HR=1.39           # A100 80GB community (check live price when launching)
STAGE1_CAP_USD=6                  # mocap pod self-destructs past this
STAGE2_RATE_USD_HR=0.34           # RTX 4090 24GB community (secure is ~0.69-0.89)
STAGE2_CAP_USD=3                  # render/style pod self-destructs past this
# TOTAL_BUDGET_USD is tracked across ALL runs in B2 (ledger/ledger.csv); no pod starts if it could pass it.

# --- Re-run options (set when launching the pod) ---
STYLE_TAG="${STYLE_TAG:-v1}"      # name for this look; each tag gets its own MP4
RESTYLE_ONLY="${RESTYLE_ONLY:-0}" # 1 = reuse saved raw frames, only redo upscale+style (cheapest re-run)
PREVIEW_EVERY="${PREVIEW_EVERY:-1}"                 # e.g. 10 = style every 10th frame (~1/10 the cost) to test a look first
